# Backend configuration. Copy this file to `.env` and adjust as needed.
# Every value has a sensible default, so for a quick local run you can also just
# use `npm run dev` with no .env at all.

# --- Core ---
PORT=8787
# Any clients (and the Bearer token for the dashboard key sign-in) use this.
API_SECRET=replace-with-a-long-random-secret
DEMO_MODE=true

# Where the JSON ledger is written. Defaults to ./data locally.
# The deployment sets this to the persistent volume (e.g. /app/data).
# DATA_DIR=./data

# --- Local development ---
# Open /admin/ from localhost without Telegram sign-in. Keep this false (or unset)
# anywhere reachable from the network. `npm run dev` turns it on automatically.
# ALLOW_LOCAL_ADMIN=true
# Skip Telegram polling entirely (no bot token needed). `npm run dev` sets this too.
# DISABLE_TELEGRAM=true

# --- Telegram (optional) ---
# Leave empty to run without a bot. Set both to enable the bot + dashboard sign-in.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
